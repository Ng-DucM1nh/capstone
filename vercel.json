{
  "version": 2,
  "regions": ["syd1"],
  "builds": [
    { "src": "api/light/index.py", "use": "@vercel/python" },
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/health/db", "dest": "api/light/index.py" },
    { "src": "/api/health", "dest": "api/light/index.py" },
    { "src": "/api/auth/(.*)", "dest": "api/light/index.py" },
    { "src": "/api/filters/(.*)", "dest": "api/light/index.py" },
    { "src": "/api/summary/(.*)", "dest": "api/light/index.py" },
    { "src": "/api/charts/timeseries-grain", "dest": "api/light/index.py" },
    { "src": "/api/charts/timeseries", "dest": "api/light/index.py" },
    { "src": "/api/charts/distribution", "dest": "api/light/index.py" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/login.html", "dest": "/frontend/login.html" },
    { "src": "/dashboard.html", "dest": "/frontend/dashboard.html" },
    { "src": "/", "dest": "/frontend/login.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "crons": [
    {
      "path": "/api/email/process-due",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
